# TEMPLATE ONLY -- no real values in this file, ever. It is committed; `.env` is not.
#
# Prefer NOT to create a local .env at all. `railway run <command>` injects the real
# variables from Railway into one process without writing them to disk, and running
# the ingest locally otherwise means putting PRODUCTION DATABASE CREDENTIALS on a
# laptop -- a much bigger secret than any API key here.
#
#   railway link
#   railway run python scripts/ingest_kb.py --brand RON --dry-run

# --- App database (Railway Postgres) ---
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Sell.do reporting DBs (read-only mirror, NOT the CRM API) ---
SELLDO_DB_URL_RON=postgresql://...
SELLDO_DB_URL_ELEMENTS=postgresql://...

# --- Meta access tokens ---
META_TOKEN_RON=EAAS...
META_TOKEN_ELEMENTS=EAAV...

# --- Wati (official WhatsApp Cloud API) ---
# Base URL from Wati dashboard -> API Docs (no trailing slash)
WATI_BASE=https://live-server-12345.wati.io
# Access token from Wati -> API Docs. Paste WITHOUT "Bearer ".
WATI_TOKEN=
# Wati sends no custom headers, so this must stay BLANK or every real post 403s.
WATI_WEBHOOK_SECRET=
# Shared secret carried in the webhook PATH instead: /webhook/wati/<token>.
# Blank disables the authenticated route entirely.
WATI_PATH_TOKEN=

# --- Knock templates (Phase 5, task 17) ---
# The amended 4-knock set: T1 lifestyle (day 0) / T2 location (day 3) /
# T3 low-density (day 10) / T6 visit invitation (day 25, rewritten to drop the
# booking flow). Blank until Meta approves them. The six carnival templates are gone.
WATI_TPL_T1=
WATI_TPL_T2=
WATI_TPL_T3=
WATI_TPL_T6=

# =============================================================================
# SEND SAFETY (Phase 0). Read the comments before changing any of these.
# =============================================================================

# THE MASTER SWITCH. Nothing sends while this is false. Leave it false until the
# knock engine and the qualifier exist and have been reviewed. It is the only thing
# standing between this code and real phone numbers -- the accidental guard that used
# to do that job (the carnival date comparisons) has been deleted.
SEND_ENABLED=false

# Operator brake, pullable mid-incident without a redeploy.
GLOBAL_PAUSE=false

# Fatigue: the journey count is resettable by a defined reason; the rolling window
# ceiling is NOT resettable by anything, which is what makes a generous reset safe.
KNOCK_MAX_PER_JOURNEY=4
FATIGUE_MAX_PER_WINDOW=2
FATIGUE_WINDOW_DAYS=7

# Retry ceiling, by whose fault the failure was. Failures classed `system` (template
# unapproved, bad token, 24h window shut) have NO ceiling -- our own misconfiguration
# must never kill off a good lead.
RETRY_MAX_RECIPIENT=3
RETRY_MAX_TRANSIENT=6
RETRY_WINDOW_DAYS=30

# Number-level protection (WhatsApp messaging tier), separate from per-person limits.
MAX_SENDS_PER_HOUR=30
DAILY_SEND_CAP=250
SEND_BATCH_PER_TICK=10

# Budget gate. Rupees, not crores, so a comparison site cannot mix units.
# Only the FLOOR rejects -- somebody above the ceiling is a good problem, not an
# unqualified lead. The bot compares against these silently and never quotes them;
# no price is in the corpus to quote.
# The floor was wrong (1.5cr) until the real price sheet arrived showing 1.28cr.
# Budget is a HARD gate, so a wrong floor discards qualified buyers silently.
BUDGET_FLOOR=12800000
BUDGET_CEILING=55000000

# =============================================================================
# KNOWLEDGE BASE / RAG
# =============================================================================

# Voyage embeddings. Multilingual, which matters: this audience writes Tanglish on
# WhatsApp and matching that to the right FAQ row IS the retrieval step.
# NOTE: the 3-series model names (voyage-3-large) are superseded. Use the 4-series.
VOYAGE_API_KEY=
EMBED_MODEL=voyage-4-large
# Baked into the kb_chunks column type. Changing it is a full RE-INDEX, not an edit --
# vectors of different dimensions cannot be compared.
EMBED_DIM=1024
EMBED_BATCH=100
RETRIEVE_K=6
RETRIEVE_OVERFETCH=40

# --- Dashboard auth (basic) ---
DASH_USER=admin
DASH_PASS=change-me

# --- Polling intervals (minutes) ---
SELLDO_POLL_MIN=10
META_ADS_POLL_MIN=30
SEQUENCER_TICK_MIN=5

# --- Legacy, dead. WasenderAPI is superseded by Wati; /webhook/wasender should be
# closed with task 12 (it is unauthenticated and can mutate lead records). ---
WASENDER_API_KEY=
WASENDER_SESSION_ID=
WASENDER_WEBHOOK_SECRET=
